{
  "expo": {
    "name": "Materna",
    "slug": "materna",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/materna-app-icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/materna-app-icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.materna"
    },
    "android": {
      "icon": "./assets/materna-app-icon.png"
    },
    "plugins": [
      "expo-asset",
      "@react-native-community/datetimepicker"
    ],
    "web": {
      "bundler": "metro"
    },
    "experiments": {
      "baseUrl": "/Materna"
    }
  }
}
