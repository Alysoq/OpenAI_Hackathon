{
  "expo": {
    "name": "Materna",
    "slug": "materna",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/materna-app-icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/materna-app-icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.materna"
    },
    "android": {
      "icon": "./assets/materna-app-icon.png"
    },
    "plugins": [
      "expo-asset",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Materna to take photos for symptom support.",
          "photosPermission": "Allow Materna to select photos for symptom support."
        }
      ],
      "expo-document-picker"
    ],
    "web": {
      "bundler": "metro"
    },
    "experiments": {
      "baseUrl": "/Materna"
    }
  }
}
